@baseUrl = http://localhost:3000
@contentType = application/json

# Credenciais do usuário de teste
@userEmail = user@example.com
@userPassword = password123

# Tokens capturados automaticamente dos responses de login/refresh
# (preenchidos pelo REST Client via @name + response variables)
@accessToken = {{login.response.body.$.access_token}}
@refreshToken = {{login.response.body.$.refresh_token}}

# Tokens obtidos via e-mail — preencher manualmente após consultar http://localhost:8025
@confirmationToken = <token do e-mail de confirmacao>
@resetToken = <token do e-mail de reset>

# Video funcional: ajuste o tamanho exato e coloque sample-video.mp4 ao lado deste arquivo
@videoSizeBytes = 1048576
# Depois do PUT, copie o ETag completo retornado pelo MinIO, incluindo as aspas
@uploadedPartEtag = "cole-o-etag-retornado-pelo-minio"


###
# ─────────────────────────────────────────────
# HEALTH CHECK
# ─────────────────────────────────────────────

### GET / — verifica se a API está no ar
GET {{baseUrl}}/


###
# ─────────────────────────────────────────────
# REGISTRO E CONFIRMAÇÃO DE EMAIL
# ─────────────────────────────────────────────

### 1. Registrar novo usuário
# Após o registro, consulte http://localhost:8025 para obter o token de confirmação
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}


### 2. Confirmar email com token recebido
# Cole o token do e-mail em @confirmationToken acima
GET {{baseUrl}}/auth/confirm-email?token={{confirmationToken}}

### 3. Reenviar email de confirmação
POST {{baseUrl}}/auth/resend-confirmation
Content-Type: {{contentType}}

{
  "email": "{{userEmail}}"
}


###
# ─────────────────────────────────────────────
# LOGIN E TOKENS
# ─────────────────────────────────────────────

### 4. Login — access_token e refresh_token capturados automaticamente
# @name login
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}


### 5. Renovar tokens — access_token e refresh_token atualizados automaticamente
# @name login
POST {{baseUrl}}/auth/refresh
Content-Type: {{contentType}}

{
  "refresh_token": "{{refreshToken}}"
}


###
# ─────────────────────────────────────────────
# USUÁRIO AUTENTICADO
# ─────────────────────────────────────────────

### 6. Dados do usuário autenticado
GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}


### 7. Logout — revoga todos os refresh tokens do usuário
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{accessToken}}


###
# ─────────────────────────────────────────────
# RECUPERAÇÃO DE SENHA
# ─────────────────────────────────────────────

### 8. Solicitar redefinição de senha
# Após a solicitação, consulte http://localhost:8025 para obter o token de reset
POST {{baseUrl}}/auth/forgot-password
Content-Type: {{contentType}}

{
  "email": "{{userEmail}}"
}


### 9. Redefinir senha com token recebido
# Cole o token do e-mail em @resetToken acima
POST {{baseUrl}}/auth/reset-password
Content-Type: {{contentType}}

{
  "token": "{{resetToken}}",
  "new_password": "new-password123"
}


###
# -----------------------------------------------------------------------------
# VIDEOS - UPLOAD, PROCESSAMENTO E LEITURA
# -----------------------------------------------------------------------------

### 10. Criar sessao multipart
# @name createVideo
POST {{baseUrl}}/videos
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "title": "Video funcional da Fase 03",
  "originalFilename": "sample-video.mp4",
  "contentType": "video/mp4",
  "sizeBytes": {{videoSizeBytes}}
}


### 11. Assinar a primeira parte
# @name signVideoPart
POST {{baseUrl}}/videos/{{createVideo.response.body.$.id}}/upload-parts
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "uploadId": "{{createVideo.response.body.$.uploadId}}",
  "partNumbers": [1]
}


### 12. Enviar os bytes diretamente ao MinIO
# @name uploadVideoPart
PUT {{signVideoPart.response.body.$.parts[0].url}}
Content-Type: application/octet-stream

< ./sample-video.mp4


### 13. Finalizar o upload
# Antes desta chamada, atualize @uploadedPartEtag com o header ETag do passo 12
# @name completeVideo
POST {{baseUrl}}/videos/{{createVideo.response.body.$.id}}/upload-completion
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "uploadId": "{{createVideo.response.body.$.uploadId}}",
  "parts": [
    {
      "partNumber": 1,
      "eTag": {{uploadedPartEtag}}
    }
  ]
}


### 14. Consultar ate o status ficar READY
GET {{baseUrl}}/videos/{{createVideo.response.body.$.publicId}}
Authorization: Bearer {{accessToken}}


### 15. Streaming (307 para URL assinada inline)
GET {{baseUrl}}/videos/{{createVideo.response.body.$.publicId}}/stream
Authorization: Bearer {{accessToken}}


### 16. Download (307 para URL assinada attachment)
GET {{baseUrl}}/videos/{{createVideo.response.body.$.publicId}}/download
Authorization: Bearer {{accessToken}}


### 17. Thumbnail (307 para JPEG privado assinado)
GET {{baseUrl}}/videos/{{createVideo.response.body.$.publicId}}/thumbnail
Authorization: Bearer {{accessToken}}
