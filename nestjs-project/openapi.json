                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Create a multipart video upload",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{id}/upload-parts": {
      "post": {
        "description": "Issues or renews public pre-signed URLs for selected parts of a draft video upload.",
        "operationId": "VideosController_signUploadParts",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Video upload ID",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadPartsDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upload part URLs issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadPartsResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed or part numbers are invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "VIDEO_NOT_FOUND: video is absent or belongs to another channel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "VIDEO_UPLOAD_INVALID_STATE: upload is not in DRAFT state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "VIDEO_STORAGE_UNAVAILABLE: signed URLs could not be issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Sign multipart upload parts",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{id}/upload-completion": {
      "post": {
        "description": "Completes and verifies the source object, then atomically transitions the video to processing and records an outbox command.",
        "operationId": "VideosController_completeUpload",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Video upload ID",
            "schema": {
              "format": "uuid",
