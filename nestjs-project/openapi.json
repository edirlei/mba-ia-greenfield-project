            "access-token": []
          }
        ],
        "summary": "Get owned video processing details",
        "tags": [
          "videos"
        ]
      }
    }
  },
  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "CreateVideoDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Aula de arquitetura limpa",
            "maxLength": 255
          },
          "originalFilename": {
            "type": "string",
            "example": "aula-arquitetura.mp4",
            "maxLength": 255
          },
          "contentType": {
            "type": "string",
            "example": "video/mp4",
            "maxLength": 127
          },
          "sizeBytes": {
            "type": "number",
            "example": 5242880,
            "minimum": 1,
            "maximum": 10737418240
          }
        },
        "required": [
          "title",
          "originalFilename",
          "contentType",
          "sizeBytes"
        ]
      },
      "VideoUploadResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "8f184c66-e3d9-4d3d-a2e6-5abc1d39fb7d"
          },
          "publicId": {
            "type": "string",
            "minLength": 22,
            "maxLength": 22,
            "example": "A1b2C3d4E5f6G7h8I9j0KQ"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PROCESSING",
              "READY",
              "ERROR"
            ],
            "example": "DRAFT"
          },
          "uploadId": {
            "type": "string",
            "example": "VXBsb2FkSWQtZXhhbXBsZQ"
          },
          "partSizeBytes": {
            "type": "number",
            "example": 67108864
          },
          "totalParts": {
            "type": "number",
            "example": 160
          },
          "uploadPartUrlTtlSeconds": {
            "type": "number",
            "example": 900
          }
        },
        "required": [
          "id",
          "publicId",
          "status",
          "uploadId",
          "partSizeBytes",
          "totalParts",
          "uploadPartUrlTtlSeconds"
        ]
      },
      "UploadPartsDto": {
        "type": "object",
        "properties": {
          "uploadId": {
            "type": "string",
            "example": "VXBsb2FkSWQtZXhhbXBsZQ",
            "maxLength": 512
          },
          "partNumbers": {
            "example": [
              1,
              2
            ],
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "uploadId",
          "partNumbers"
        ]
      },
      "UploadPartUrlDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "minimum": 1,
            "example": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "example": "http://localhost:9000/streamtube/videos/id/source?X-Amz-..."
          }
        },
        "required": [
          "partNumber",
          "url"
        ]
      },
      "UploadPartsResponseDto": {
        "type": "object",
        "properties": {
          "videoId": {
            "type": "string",
            "format": "uuid",
            "example": "8f184c66-e3d9-4d3d-a2e6-5abc1d39fb7d"
          },
          "uploadId": {
            "type": "string",
            "example": "VXBsb2FkSWQtZXhhbXBsZQ"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-09T12:15:00.000Z"
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadPartUrlDto"
            }
          }
        },
        "required": [
          "videoId",
          "uploadId",
          "expiresAt",
          "parts"
        ]
      },
      "CompleteVideoPartDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1,
            "minimum": 1
          },
          "eTag": {
            "type": "string",
            "example": "\"d41d8cd98f00b204e9800998ecf8427e\""
          }
        },
        "required": [
          "partNumber",
          "eTag"
        ]
      },
      "CompleteVideoUploadDto": {
        "type": "object",
        "properties": {
          "uploadId": {
            "type": "string",
            "example": "VXBsb2FkSWQtZXhhbXBsZQ",
            "maxLength": 512
          },
          "parts": {
            "example": [
              {
                "partNumber": 1,
                "eTag": "\"d41d8cd98f00b204e9800998ecf8427e\""
              }
            ],
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompleteVideoPartDto"
            }
          }
        },
        "required": [
          "uploadId",
          "parts"
        ]
      },
      "VideoCompletionResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "8f184c66-e3d9-4d3d-a2e6-5abc1d39fb7d"
          },
          "publicId": {
            "type": "string",
            "minLength": 22,
            "maxLength": 22,
            "example": "A1b2C3d4E5f6G7h8I9j0KQ"
          },
          "status": {
            "type": "string",
            "enum": [
              "PROCESSING",
              "READY"
            ],
            "example": "PROCESSING"
          }
        },
        "required": [
          "id",
          "publicId",
          "status"
        ]
      },
      "VideoMetadataResponseDto": {
        "type": "object",
        "properties": {
          "formatName": {
            "type": "string",
            "example": "mov,mp4,m4a,3gp,3g2,mj2"
          },
          "formatLongName": {
            "type": "string",
            "example": "QuickTime / MOV"
          },
          "bitRate": {
            "type": "number",
            "minimum": 0,
            "example": 1250000
          },
          "videoCodec": {
            "type": "string",
            "example": "h264"
          },
          "width": {
            "type": "number",
            "minimum": 1,
            "example": 1920
          },
          "height": {
            "type": "number",
            "minimum": 1,
            "example": 1080
          },
          "frameRate": {
            "type": "number",
            "minimum": 0,
            "example": 30
          }
        },
        "required": [
          "formatName",
          "formatLongName",
          "bitRate",
          "videoCodec",
          "width",
          "height",
          "frameRate"
        ]
      },
      "VideoDetailsResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "8f184c66-e3d9-4d3d-a2e6-5abc1d39fb7d"
          },
          "publicId": {
            "type": "string",
            "minLength": 22,
            "maxLength": 22,
            "example": "A1b2C3d4E5f6G7h8I9j0KQ"
          },
          "title": {
            "type": "string",
            "example": "Aula de arquitetura limpa"
          },
          "originalFilename": {
            "type": "string",
            "example": "aula-arquitetura.mp4"
          },
          "contentType": {
            "type": "string",
            "example": "video/mp4"
          },
          "sizeBytes": {
            "type": "number",
            "format": "int64",
            "minimum": 1,
            "example": 5242880
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PROCESSING",
              "READY",
              "ERROR"
            ],
            "example": "READY"
          },
          "durationSeconds": {
            "type": "number",
            "nullable": true,
            "minimum": 0,
            "example": 12.345
          },
          "metadata": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoMetadataResponseDto"
              }
            ]
          },
          "thumbnailAvailable": {
            "type": "boolean",
            "example": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-09T12:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-09T12:01:00.000Z"
          }
        },
        "required": [
          "id",
          "publicId",
          "title",
          "originalFilename",
          "contentType",
          "sizeBytes",
          "status",
          "thumbnailAvailable",
          "createdAt",
          "updatedAt"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}