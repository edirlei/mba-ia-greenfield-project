# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube" <noreply@streamtube.com>

# Object storage (MinIO locally, S3-compatible in production)
STORAGE_INTERNAL_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=streamtube
STORAGE_ACCESS_KEY=streamtube
STORAGE_SECRET_KEY=streamtube-secret
STORAGE_UPLOAD_URL_TTL_SECONDS=900
STORAGE_READ_URL_TTL_SECONDS=300
MINIO_PUBLISHED_PORT=9000
MINIO_CONSOLE_PUBLISHED_PORT=9001
MINIO_CORS_ALLOW_ORIGIN=http://localhost:3000,http://localhost:3001
MINIO_STALE_UPLOADS_EXPIRY=24h
MINIO_STALE_UPLOADS_CLEANUP_INTERVAL=1h

# Queue (Redis + BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PUBLISHED_PORT=6379
REDIS_DB=0
REDIS_PREFIX=streamtube

# Video processing
VIDEO_PROCESSING_CONCURRENCY=1
VIDEO_PROCESSING_ATTEMPTS=5
VIDEO_PROCESSING_BACKOFF_MS=5000
VIDEO_PROCESSING_TEMP_DIR=/tmp/streamtube-videos
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=25
